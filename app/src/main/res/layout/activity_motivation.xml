<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/img_8">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"    android:textColor="@color/black"
            android:text="Quote of the day"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/quoteTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quote will appear here"
            android:textSize="18sp"
            android:textStyle="italic"
            android:padding="16dp"
            android:background="#FFF3E0" />

        <Button
            android:id="@+id/copyButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Copy Quote"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recommended Books"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoLink="web"
            android:text="• Can't Hurt Me – David Goggins: https://www.amazon.in/Cant-Hurt-Me-Master-Your-ebook/dp/B07H453KGH"
            android:layout_marginTop="8dp"
            android:textColor="#0000EE" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoLink="web"
            android:text="• The Power of Positive Thinking: https://www.amazon.in/Power-Positive-Thinking-Norman-Vincent/dp/0091906385"
            android:layout_marginTop="4dp"
            android:textColor="#0000EE" />
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/imageGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:columnCount="3"
                android:rowCount="2"
                android:alignmentMode="alignMargins"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/image1"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="4dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_22" />

                <ImageView
                    android:id="@+id/image2"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="4dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_23" />

                <ImageView
                    android:id="@+id/image3"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="4dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_24" />

                <ImageView
                    android:id="@+id/image4"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="4dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_25" />

                <ImageView
                    android:id="@+id/image5"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="4dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_26" />

                <ImageView
                    android:id="@+id/image6"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="4dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_27" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</ScrollView>
