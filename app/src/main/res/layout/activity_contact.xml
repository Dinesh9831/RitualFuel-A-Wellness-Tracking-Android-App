<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bgg17"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Troubleshoot"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp" />

        <!-- Troubleshoot cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <!-- Repeat this block for each item -->

            <!-- Item 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#E8F5E9"
                android:elevation="2dp"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:layout_marginHorizontal="4dp"
                android:clipToOutline="true">

                <TextView
                    android:id="@+id/troubleshoot1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• App is not opening"
                    android:textColor="#1E88E5"
                    android:textSize="16sp"
                    android:paddingVertical="4dp" />

                <TextView
                    android:id="@+id/answer1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Try clearing app cache and restarting your phone."
                    android:textColor="#444"
                    android:textSize="14sp"
                    android:visibility="gone"
                    android:paddingTop="4dp" />
            </LinearLayout>

            <!-- Item 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#E8F5E9"
                android:elevation="2dp"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:layout_marginHorizontal="4dp"
                android:clipToOutline="true">

                <TextView
                    android:id="@+id/troubleshoot2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Login issues"
                    android:textColor="#1E88E5"
                    android:textSize="16sp"
                    android:paddingVertical="4dp" />

                <TextView
                    android:id="@+id/answer2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Make sure your internet is stable and credentials are correct."
                    android:textColor="#444"
                    android:textSize="14sp"
                    android:visibility="gone"
                    android:paddingTop="4dp" />
            </LinearLayout>

            <!-- Item 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#E8F5E9"
                android:elevation="2dp"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:layout_marginHorizontal="4dp"
                android:clipToOutline="true">

                <TextView
                    android:id="@+id/troubleshoot3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Payment problems"
                    android:textColor="#1E88E5"
                    android:textSize="16sp"
                    android:paddingVertical="4dp" />

                <TextView
                    android:id="@+id/answer3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Check your payment method or try again later."
                    android:textColor="#444"
                    android:textSize="14sp"
                    android:visibility="gone"
                    android:paddingTop="4dp" />
            </LinearLayout>

            <!-- Item 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#E8F5E9"
                android:elevation="2dp"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:layout_marginHorizontal="4dp"
                android:clipToOutline="true">

                <TextView
                    android:id="@+id/troubleshoot4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Notifications not working"
                    android:textColor="#1E88E5"
                    android:textSize="16sp"
                    android:paddingVertical="4dp" />

                <TextView
                    android:id="@+id/answer4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ensure app notifications are enabled in settings."
                    android:textColor="#444"
                    android:textSize="14sp"
                    android:visibility="gone"
                    android:paddingTop="4dp" />
            </LinearLayout>

            <!-- Item 5 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#E8F5E9"
                android:elevation="2dp"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:layout_marginHorizontal="4dp"
                android:clipToOutline="true">

                <TextView
                    android:id="@+id/troubleshoot5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Other issues"
                    android:textColor="#1E88E5"
                    android:textSize="16sp"
                    android:paddingVertical="4dp" />

                <TextView
                    android:id="@+id/answer5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Contact us directly for further help."
                    android:textColor="#444"
                    android:textSize="14sp"
                    android:visibility="gone"
                    android:paddingTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Contact email -->
        <TextView
            android:id="@+id/contact_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ritualfree@gmail.com"
            android:textSize="18sp"
            android:textColor="#1E88E5"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"
            android:layout_gravity="center_horizontal" />

        <!-- Contact phone -->
        <TextView
            android:id="@+id/contact_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+91 9390107209"
            android:textSize="18sp"
            android:textColor="#1E88E5"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:layout_gravity="center_horizontal" />

        <!-- Footer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="For more information contact ritualfree@gmail.com"
            android:textColor="#666"
            android:textSize="12sp"
            android:layout_marginTop="8dp"
            android:layout_gravity="center_horizontal" />

    </LinearLayout>
</ScrollView>
